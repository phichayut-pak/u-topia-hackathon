# Copy to .env.local and fill in what you have. Anything left empty falls back to labelled sample behaviour.

# Claude: writes the plain-language explanations (English + Thai)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Coin warnings: "bitkub" = free live 24h price moves (default), "tokenomist" = upcoming unlock events
WARNING_SOURCE=bitkub
PRICE_MOVE_PCT=5

# Tokenomist: only used when WARNING_SOURCE=tokenomist (team leader's hackathon key; needs forward-looking data)
TOKENOMIST_API_KEY=
WATCH_TOKEN_ID=arbitrum
UNLOCK_THRESHOLD_PCT=2

# ElevenLabs: reads explanations aloud (browser voice is used when empty)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Avalanche Fuji (optional): settle each USDT payment on-chain as a real tUSDT transfer
# from the demo user's wallet to the treasury. Testnet only. Never put a real wallet's key here.
# Deploy the test token first: FUJI_PRIVATE_KEY=<treasury key> npm run deploy-token
FUJI_USER_PRIVATE_KEY=
TREASURY_ADDRESS=
TOKEN_ADDRESS=
TOKEN_DECIMALS=6
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Where the SQLite database lives (Railway: the volume at /app/data)
# DATA_DIR=
